<?xml version="1.0"?>
<robot name="lio" xmlns:xacro="http://tixiaoshan.github.io/">
  <xacro:property name="PI" value="3.1415926535897931" />

  <link name="odom"></link>

    <link name="base_link"></link>
    <joint name="base_link_joint" type="fixed">
      <parent link="odom"/>
      <child link="base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <link name="odom_wheel_link"></link>
    <joint name="wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="odom_wheel_link"/>
      <origin xyz="0 0 0.0845" rpy="0 0 0"/>
    </joint>

    <link name="laser_link"> </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link" />
      <child link="laser_link" />
      <origin xyz="0.124 0 0.20142" rpy="0 0 0" />
    </joint>

    <link name="imu_link"> </link>
    <joint name="imu_joint" type="fixed">
      <parent link="laser_link" />
      <child link="imu_link" />
      <origin xyz="0.08 0 -0.055" rpy="3.14 0 0" />
    </joint>

    <link name="camera_left_depth_optical_frame"> </link>
    <joint name="camera_left_joint" type="fixed">
      <parent link="base_link" />
      <child link="camera_left_depth_optical_frame" />
      <origin
        xyz="0.268526757018066 -0.0555348839735371 -0.0214999999778343"
        rpy="-1.5707963267949 0 -1.83259571459405" />

    </joint> 

    <link name="camera_right_depth_optical_frame"> </link>
      <joint name="camera_right_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_right_depth_optical_frame" />
        <origin
          xyz="0.268526757018066 0.0555348839735374 -0.0214999999778343"
          rpy="1.5707963267949 0 1.83259571459405" />
      </joint> 

     
    <link name="navsat_link"> </link>
    <joint name="navsat_joint" type="fixed">
      <parent link="base_link" />
      <child link="navsat_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

</robot>
